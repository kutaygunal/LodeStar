// Jenkinsfile
// Lodestar CI pipeline (S2 Phase 9 - Full CI/CD).
// Builds with LODESTAR_BUILD_TESTS=ON, runs the test-gate script, and builds a
// matrix of configurations (Release / Debug). The build FAILS if any test
// target fails (test gate).

pipeline {
    agent any

    options {
        timestamps()
        disableConcurrentBuilds()
    }

    // Matrix of at least 2 configurations (S2 Phase 9 contract).
    matrix {
        axes {
            axis {
                name 'BUILD_TYPE'
                values 'Release', 'Debug'
            }
        }
        stages {
            stage('Checkout') {
                steps {
                    checkout scm
                }
            }

            stage('Configure') {
                steps {
                    // Build with tests enabled so the test gate can run.
                    sh 'cmake -S . -B build -DCMAKE_BUILD_TYPE=${BUILD_TYPE} -DLODESTAR_BUILD_TESTS=ON'
                }
            }

            stage('Build') {
                steps {
                    sh 'cmake --build build --config ${BUILD_TYPE}'
                }
            }

            stage('Test gate') {
                steps {
                    // Run every *_tests.exe in the build tree; fails on any
                    // non-zero exit or timeout (ci/run_all_tests.sh).
                    sh 'ci/run_all_tests.sh build 120'
                }
            }
        }
    }

    post {
        success {
            echo 'Lodestar build + test gate completed successfully.'
        }
        failure {
            echo 'Lodestar build or test gate failed.'
        }
    }
}
